# 공개 인증 설정 (브라우저에 포함됩니다)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용: 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
# Supabase Secret key 또는 기존 service_role 키를 로컬/배포 환경에 직접 설정합니다.
SUPABASE_SECRET_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
# 인증 없는 데모: 서버의 .feynloop-data에 저장 (단일 서버 개발용)
ALLOW_DEMO=true
# 필요한 경우 영속 디스크의 절대 경로 지정
FEYNLOOP_DATA_DIR=
