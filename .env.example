# Supabase DB 주소 (기존 공개 변수도 서버에서 사용할 수 있습니다)
NEXT_PUBLIC_SUPABASE_URL=
# 이전 이메일 계정의 기록 이관에만 사용하는 공개 키
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용: 실제 키는 .env.local에만 넣으세요.
SUPABASE_SECRET_KEY=
# Google AI Studio에서 발급한 Gemini API 키 (없으면 데모)
GEMINI_API_KEY=
# 계정에서 사용 가능한 모델로 변경할 수 있습니다. 무료 사용 가능 여부·한도는 AI Studio에서 확인하세요.
GEMINI_MODEL=gemini-3.1-flash-lite
# 인증 없는 데모: 서버의 .feynloop-data에 저장 (단일 서버 개발용)
ALLOW_DEMO=true
# 필요한 경우 영속 디스크의 절대 경로 지정
FEYNLOOP_DATA_DIR=

# 신뢰할 수 있는 프록시가 X-Forwarded-For를 덮어쓰는 경우에만 true
FEYNLOOP_TRUST_PROXY=false
